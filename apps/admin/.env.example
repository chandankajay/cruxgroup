DATABASE_URL=mongodb://127.0.0.1:27017/crux
AUTH_SECRET=replace-with-at-least-32-characters-secret
NEXTAUTH_SECRET=replace-with-at-least-32-characters-secret

# Public web app origin for cross-project cache purge (preview URL in staging — never omit)
CRUXGROUP_WEB_URL=http://localhost:3002

# Shared with cruxgroup-web — POST /api/revalidate/services
CRUX_SERVICES_REVALIDATE_SECRET=replace-with-shared-secret-min-32-chars

BLOB_PUBLIC_READ_WRITE_TOKEN=
