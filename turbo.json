{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "APP_ENV",
    "CI",
    "NEXT_RUNTIME",
    "NEXTAUTH_SECRET",
    "AUTH_SECRET",
    "DATABASE_URL",
    "BLOB_READ_WRITE_TOKEN",
    "BLOB_PUBLIC_READ_WRITE_TOKEN",
    "AISENSY_API_KEY",
    "AISENSY_TEST_ALLOWLIST"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "APP_ENV",
        "AISENSY_TEST_ALLOWLIST",
        "NODE_ENV",
        "VERCEL",
        "VERCEL_URL",
        "NEXTAUTH_SECRET",
        "AUTH_SECRET",
        "DATABASE_URL",
        "BLOB_READ_WRITE_TOKEN",
        "BLOB_PUBLIC_READ_WRITE_TOKEN",
        "AISENSY_API_KEY",
        "AISENSY_WELCOME_TEMPLATE_NAME",
        "AISENSY_TEMPLATE_NAME",
        "AISENSY_TEMPLATE_LOGIN_CODE",
        "AISENSY_OPERATOR_LINK_TEMPLATE",
        "AISENSY_BOOKING_CONFIRM_TEMPLATE",
        "AISENSY_PARTNER_OVERRUN_TEMPLATE",
        "AISENSY_INVOICE_PAYMENT_TEMPLATE",
        "AISENSY_INVOICE_OVERDUE_REMINDER_TEMPLATE",
        "AISENSY_PAYSLIP_TEMPLATE",
        "AISENSY_PARTNER_SERVICE_DUE_TEMPLATE",
        "AISENSY_BOOKING_NOTIFICATION",
        "AISENSY_PROGRESS_BOOKING_RECEIVED_TEMPLATE",
        "AISENSY_PROGRESS_BOOKING_CONFIRMED_TEMPLATE",
        "AISENSY_PROGRESS_MACHINE_ASSIGNED_TEMPLATE",
        "AISENSY_PROGRESS_ON_SITE_TEMPLATE",
        "AISENSY_PROGRESS_JOB_COMPLETED_TEMPLATE",
        "NEXTAUTH_URL",
        "AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "ALLOWED_ADMIN_EMAILS",
        "RAZORPAY_KEY_ID",
        "RAZORPAY_KEY_SECRET",
        "CRON_SECRET",
        "NEXT_PUBLIC_BOOKINGS_URL",
        "NEXT_PUBLIC_NODE_ENV",
        "NEXT_PUBLIC_ADMIN_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_EMAIL",
        "BOOKINGS_APP_ORIGIN",
        "KYC_DOC_VIEW_SECRET"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.{test,spec}.{ts,tsx}", "vitest.config.*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
