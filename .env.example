# Copy to `.env` (or set in Vercel per app). Required for Auth.js apps (admin, bookings).
# Generate a value: `npx auth secret`
AUTH_SECRET=

# Legacy alias (optional if AUTH_SECRET is set)
# NEXTAUTH_SECRET=

# Recommended separate key for signed KYC document view URLs (crux-admin). Without it, signing reuses AUTH_SECRET (same as the session key).
KYC_DOC_VIEW_SECRET=
