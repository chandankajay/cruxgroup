# Copy to .env.local per app or use Vercel env pull. Never commit secrets.

# deployment tier: dev | prod | ci  (short values match Vercel env)
APP_ENV=dev

# MongoDB (Atlas per environment — dev vs prod clusters)
DATABASE_URL=mongodb://127.0.0.1:27017/crux_dev

AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=

# Comma-separated E.164 or 10-digit Indian numbers allowed for WhatsApp outside prod
AISENSY_TEST_ALLOWLIST=919999999999
AISENSY_API_KEY=

# Razorpay: rzp_test_* on dev, rzp_live_* only when APP_ENV=prod
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
